{
  "name": "02_LLB_Auth_OTP_Password_Reset",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "auth-otp",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "name": "Webhook: OTP Requested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.channel }}",
              "value2": "sms"
            }
          ]
        }
      },
      "name": "Channel Check (SMS vs Email)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "from": "LLBREAL",
        "to": "={{ $json.body.destination }}",
        "message": "=LLB Real Estate Security: Your 6-digit verification code is {{ $json.body.otp }}. Valid for 10 minutes. Do not share this code with anyone."
      },
      "name": "Dispatch SMS Gateway",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [700, 200]
    },
    {
      "parameters": {
        "fromEmail": "security@llbrealestate.com",
        "toEmail": "={{ $json.body.destination }}",
        "subject": "🔒 LLB Real Estate — Password Reset OTP",
        "html": "=<h3>Security Verification Code</h3><p>Dear {{ $json.body.userName }},</p><p>You requested a password reset. Your 6-digit security PIN is:</p><h1 style='color: #D4AF37; letter-spacing: 4px;'>{{ $json.body.otp }}</h1><p>This code expires in 10 minutes. If you did not make this request, please contact our VIP Concierge immediately.</p>"
      },
      "name": "Dispatch High-Priority SMTP",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [700, 400]
    }
  ],
  "connections": {
    "Webhook: OTP Requested": {
      "main": [
        [
          {
            "node": "Channel Check (SMS vs Email)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Channel Check (SMS vs Email)": {
      "main": [
        [
          {
            "node": "Dispatch SMS Gateway",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Dispatch High-Priority SMTP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true
}
